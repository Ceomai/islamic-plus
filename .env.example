# Copy to .env and fill from Supabase Dashboard → Settings → API
# anon key MUST start with eyJ (no extra spaces or characters)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key

# Optional server features (see supabase/README.md section 8); leave unset until the functions are deployed
# EXPO_PUBLIC_ASSISTANT_REMOTE=1
# EXPO_PUBLIC_PLACES_PROXY=1   # only with GOOGLE_PLACES_API_KEY set on the function
